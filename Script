    or not PUSL
    or type(PUSL.configure) ~= "function"
    or type(PUSL.validate) ~= "function"
    or type(PUSL.getKeyUrl) ~= "function"
then
    return warn("[AlphaX] Panda Auth não inicializou corretamente.")
end

