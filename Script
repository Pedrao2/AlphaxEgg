local function createButton(text, position, size, accent)
    local Button = Instance.new("TextButton")

    Button.Size = size
    Button.Position = position
    Button.BorderSizePixel = 0
    Button.Text = text
    Button.TextColor3 = Color3.fromRGB(235, 236, 241)
    Button.Font = Enum.Font.GothamBold
    Button.TextSize = 10
    Button.AutoButtonColor = false

    Button.BackgroundColor3 = accent
        and Color3.fromRGB(102, 75, 229)
        or Color3.fromRGB(28, 29, 36)

    Button.Parent = Main

    Instance.new("UICorner", Button).CornerRadius = UDim.new(0, 10)

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = accent
        and Color3.fromRGB(140, 113, 255)
        or Color3.fromRGB(54, 57, 69)

    Stroke.Transparency = 0.35
    Stroke.Parent = Button

    local ButtonScale = Instance.new("UIScale")
    ButtonScale.Scale = 1
    ButtonScale.Parent = Button

    Button.MouseButton1Down:Connect(function()
        TweenService:Create(
            ButtonScale,
            TweenInfo.new(0.06),
            {Scale = 0.965}
        ):Play()
    end)

    Button.MouseButton1Up:Connect(function()
        TweenService:Create(
            ButtonScale,
            TweenInfo.new(0.14, Enum.EasingStyle.Back),
            {Scale = 1}
        ):Play()
    end)

    return Button
end

