local function updateScale()
    local camera = workspace.CurrentCamera

    if not camera then
        return
    end

    local viewport = camera.ViewportSize

    Scale.Scale = math.clamp(
        math.min(
            viewport.X / 450,
            viewport.Y / 380,
            1
        ),
        0.68,
        1
    )
end

updateScale()

task.spawn(function()
    while Gui.Parent do
        updateScale()
        task.wait(0.4)
    end
end)

local authenticated = false
local validating = false
local authenticationResult = nil

GetKey.MouseButton1Click:Connect(function()
    Status.Text = "Generating key link..."
    Status.TextColor3 = Color3.fromRGB(140, 143, 156)

    local success, url = pcall(function()
        return PUSL.getKeyUrl()
    end)

    if not success
        or type(url) ~= "string"
        or url == ""
    then
        Status.Text = "Failed to generate the key URL."
        Status.TextColor3 = Color3.fromRGB(235, 105, 105)
        return
    end

    if setclipboard then
        local copied = pcall(function()
            setclipboard(url)
        end)

        if copied then
            Status.Text = "Key link copied! Open it in your browser."
            Status.TextColor3 = Color3.fromRGB(109, 222, 151)
            return
        end
    end

    Status.Text = url
    Status.TextColor3 = Color3.fromRGB(190, 192, 204)
end)

local function validateKey()
    if validating or authenticated then
        return
    end

    local key = tostring(KeyInput.Text or "")
        :gsub("^%s+", "")
        :gsub("%s+$", "")

    if key == "" then
        Status.Text = "Paste your key first."
        Status.TextColor3 = Color3.fromRGB(235, 171, 91)
        return
    end

    validating = true

    Verify.Text = "CHECKING..."
    Status.Text = "Verifying your key..."
    Status.TextColor3 = Color3.fromRGB(140, 143, 156)

    local success, result = pcall(function()
        return PUSL.validate(key)
    end)

    if not success then
        Verify.Text = "VERIFY KEY"
        Status.Text = "Authentication request failed."
        Status.TextColor3 = Color3.fromRGB(235, 105, 105)

        validating = false
        return
    end

    if type(result) ~= "table"
        or result.success ~= true
    then
        Verify.Text = "TRY AGAIN"
        Status.Text = "Invalid or expired key."
        Status.TextColor3 = Color3.fromRGB(235, 105, 105)

        validating = false
        return
    end

    -- Guarda para a sessão atual.
    pcall(function()
        getgenv().AlphaXKey = key
    end)

    authenticationResult = result
    authenticated = true

    Verify.Text = "AUTHENTICATED"
    Status.Text = "Access granted!"
    Status.TextColor3 = Color3.fromRGB(109, 222, 151)

    task.wait(0.45)

    TweenService:Create(
        Scale,
        TweenInfo.new(
            0.20,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.In
        ),
        {
            Scale = Scale.Scale * 0.92
        }
    ):Play()

    TweenService:Create(
        Main,
        TweenInfo.new(0.18),
        {
            BackgroundTransparency = 1
        }
    ):Play()

    TweenService:Create(
        Background,
        TweenInfo.new(0.20),
        {
            BackgroundTransparency = 1
        }
    ):Play()

    for _, object in ipairs(Main:GetDescendants()) do
        if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox")
        then
            TweenService:Create(
                object,
                TweenInfo.new(0.15),
                {
                    TextTransparency = 1
                }
            ):Play()

        elseif object:IsA("Frame") then
            TweenService:Create(
                object,
                TweenInfo.new(0.15),
                {
                    BackgroundTransparency = 1
                }
            ):Play()

        elseif object:IsA("UIStroke") then
            TweenService:Create(
                object,
                TweenInfo.new(0.15),
                {
                    Transparency = 1
                }
            ):Play()
        end
    end

    task.wait(0.22)

    if Gui then
        Gui:Destroy()
    end
end

Verify.MouseButton1Click:Connect(validateKey)

KeyInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        validateKey()
    end
end)

repeat
